//@version=5
indicator("SMC Follow Trend V14 [Rohi] - Pro Edition", shorttitle="SMC Rohi V14", overlay=true, max_boxes_count=500, max_lines_count=500, max_labels_count=500)

// =====================================================================
//  SMC ROHI PRO
//  Shell (Key Level / Recent High-Low boxes, Imbalance, Fib zones, alerts) from the
//  V13.1 indicator; engine (candles, 6 real-breakout / real-pullback patterns, ranges
//  1-4, waves, CTS / BOS, FBO) from the written specification. Price-action rule 4 removed.
// =====================================================================

// =====================================================================
//  INPUTS
// =====================================================================
gT = "Theme"
cUp   = input.color(#089981, "Bullish", group=gT)
cDn   = input.color(#F23645, "Bearish", group=gT)
cPB   = input.color(#FF9800, "Pullback / warning", group=gT)
cFBO  = input.color(#787B86, "FBO / neutral", group=gT)
cRng  = input.color(#7E57C2, "Active range", group=gT)
cZZ   = input.color(#5B9CF6, "Wave zig-zag", group=gT)
cKeyU = input.color(#00BFA5, "Key Level (bullish)", group=gT)
cKeyD = input.color(#FF5252, "Key Level (bearish)", group=gT)

gS = "Market Structure"
iShowMS  = input.bool(true, "Show CTS / BOS lines", group=gS)
iShowZZ  = input.bool(true, "Show wave zig-zag (BOS -> CTS -> higher / lower BOS)", group=gS)
iZZW     = input.int(1, "Zig-zag width", minval=1, maxval=3, group=gS)
iShowKL  = input.bool(true, "Show Recent High-Low / Key Level boxes", group=gS)
iShowVol = input.bool(true, "Show volume inside those boxes", group=gS)
iBoxExt  = input.int(15, "Boxes extend N bars to the right", minval=0, group=gS)
iShowLbl = input.bool(true, "Show labels", group=gS)
iFont    = input.string("Monospace", "Font", options=["Monospace", "Default"], group=gS)
iNeedBrk = input.bool(true, "A real pullback is recognized only after a real breakout", group=gS)
iBootN   = input.int(20, "Real breakout reference: swing of the last N candles", minval=5, group=gS)

gC = "Candle definitions (% of candle range)"
iDojiBody   = input.float(20, "Doji: max body %", minval=0, maxval=100, group=gC)
iDojiShadow = input.float(20, "Doji: min each shadow %", minval=0, maxval=100, group=gC)
iDojiMid    = input.float(30, "Doji: Open/Close max distance from mid %", minval=0, maxval=100, group=gC)
iPinBody    = input.float(35, "Pinbar: max body %", minval=0, maxval=100, group=gC)
iPinMain    = input.float(45, "Pinbar: min dominant shadow %", minval=0, maxval=100, group=gC)
iPinMult    = input.float(2.0, "Pinbar: dominant shadow >= x body", minval=0, group=gC)
iPinOpp     = input.float(35, "Pinbar: max opposite shadow %", minval=0, maxval=100, group=gC)
iMaruBody   = input.float(60, "Marubozu: min body % (acceptable)", minval=0, maxval=100, group=gC)
iMaruShadow = input.float(40, "Marubozu: max sum of shadows % (acceptable)", minval=0, maxval=100, group=gC)
iMaruPref   = input.float(70, "Marubozu: preferred body % (strong marubozu)", minval=0, maxval=100, group=gC)
iBigStrong  = input.bool(true, "Big marubozu must be a strong (preferred) marubozu", group=gC)
iBigN       = input.int(5, "Big: compare with last N candles", minval=1, group=gC)
iBigMin     = input.int(3, "Big: longer than at least", minval=1, group=gC)

gP = "Real breakout / pullback patterns"
iR70    = input.float(70, "Cond.1: C2 length >= % of C1", group=gP)
iR30    = input.float(30, "Cond.3: C2 length <= % of C1", group=gP)
iLine30 = input.float(30, "Cond.2/3: share of C1 beyond the line > %", group=gP)
iR40    = input.float(40, "Pattern C: C1, C2 length >= % of C3", group=gP)
iNear   = input.float(5, "Pattern B: C2 close within % of C1 length", group=gP)
iStrict = input.bool(true, "Strict confirm: cond.2/3 cancelled if C2 or C3 closes back on the original side", group=gP)

gR = "Ranges"
iShowRng = input.bool(true, "Show range boxes", group=gR)
iConfirm = input.int(2, "Anchor range: confirmation candles after the anchor", minval=1, group=gR)
iHide    = input.bool(false, "Hide Ranges inside the Correction Zone", group=gR)

gF = "FBO (fake breakout)"
iFarAfter = input.int(3, "Far-side rule starts after N candles from the first crossing", minval=1, maxval=6, group=gF)

gI = "Imbalance (FVG)"
iShowImb         = input.bool(true, "Show imbalance lines", group=gI)
iBlockFVG        = input.bool(true, "Hide FVG while a range is active", group=gI)
colBullStrongest = input.color(color.new(color.teal, 0), "Bullish strongest", group=gI)
colBullStrong    = input.color(color.new(color.blue, 0), "Bullish strong", group=gI)
colBullWeak      = input.color(color.new(color.gray, 0), "Bullish weak", group=gI)
colBearStrongest = input.color(color.new(color.maroon, 0), "Bearish strongest", group=gI)
colBearStrong    = input.color(color.new(color.red, 0), "Bearish strong", group=gI)
colBearWeak      = input.color(color.new(color.gray, 0), "Bearish weak", group=gI)

gB = "Fib zones"
iShowFib = input.bool(true, "Show 0.618 / 0.8 zones", group=gB)
cFib     = input.color(color.new(color.purple, 50), "Fib color", group=gB)

gD = "Dashboard"
iDash    = input.bool(true, "Show dashboard", group=gD)
iDashPos = input.string("Top Right", "Position", options=["Top Left", "Top Right", "Bottom Left", "Bottom Right"], group=gD)

gX = "Debug"
iColorTypes = input.bool(false, "Color candles by type", group=gX)
iMarks      = input.bool(false, "Show pattern shapes (1 / 2-3 / A / B / C) and Big candles", group=gX)
iDbg        = input.bool(false, "Show pattern ids (lock / FBO attempt)", group=gX)

// =====================================================================
//  STATE
// =====================================================================
var array<float> mBull = array.new_float()
var array<float> mBear = array.new_float()
var array<float> mAll  = array.new_float()
var array<float> pBull = array.new_float()
var array<float> pBear = array.new_float()
var array<float> pAll  = array.new_float()

// market structure (index 0 = up side tracker, 1 = down side tracker)
var int trend = 0
var int lastDir = 0
var array<float> ext     = array.new_float(2, na)   // wave extreme (H* / L*)
var array<int>   extBar  = array.new_int(2, 0)
var array<float> corr    = array.new_float(2, na)   // correction extreme (future BOS)
var array<int>   corrBar = array.new_int(2, 0)
var array<int>   phase   = array.new_int(2, 0)      // 0 = impulse, 1 = locked (pullback counted)
var array<float> fake    = array.new_float(2, na)
var array<int>   fakeBar = array.new_int(2, 0)
var array<float> bos     = array.new_float(2, na)
var array<int>   bosBarA = array.new_int(2, 0)
var array<bool>  brkOK   = array.new_bool(2, false)   // a real breakout has been seen (pullbacks allowed)

// range box (only one active)
var int boxState = 0          // 0 none, 1 pending anchor, 2 confirmed range, 3 FBO box
var int boxType = 0
var int boxDir = 0
var int boxStart = 0
var float boxTop = na
var float boxBot = na
var float exitHi = na
var float exitLo = na
var int pendCnt = 0
var int closedBar = -1
var box curBox = na

// FBO
var float fboLastLine = na
var bool fboPend = false
var float fboPLine = na
var int fboPBar = 0
var float fboPExt = na
var bool fboPConf = false
var int fboPDir = 0
var int fboStart = 0

// stored ranges (for the Hide option)
var array<box> rBoxes = array.new<box>()
var array<int> rStart = array.new_int()

var bool bearPLp = false
var bool bullPLp = false

// zig-zag
var array<int>   zzX  = array.new_int()
var array<float> zzY  = array.new_float()
var array<float> sExt  = array.new_float(2, na)
var array<float> sCorr = array.new_float(2, na)
var array<int>   sExtBar  = array.new_int(2, 0)
var array<int>   sCorrBar = array.new_int(2, 0)
var line zzL1 = na
var line keyLine = na

// per-bar series
float noLine = na
bool bigMaru = false
bool bigPin = false
bool ctsUpEvt = false
bool ctsDnEvt = false
bool tcEvt = false
bool ctsEvt = false
bool startedFbo = false
bool lockEvt = false
bool fboEvt = false
bool rngNewEvt = false
bool rngUpEvt = false
bool rngDnEvt = false
bool rngPbEvt = false
int mkBull = 0
int mkBear = 0

// =====================================================================
//  CANDLE HELPERS (k = offset)
// =====================================================================
f_rng(int k) =>
    high[k] - low[k]

f_col(int k) =>
    close[k] > open[k] ? 1 : close[k] < open[k] ? -1 : 0

// 0 none, 1 doji, 2 bullish pinbar, 3 bearish pinbar, 4 marubozu, 5 normal
f_type(int k) =>
    float r = high[k] - low[k]
    int t = 0
    if r > 0
        float body = math.abs(close[k] - open[k])
        float topS = high[k] - math.max(open[k], close[k])
        float botS = math.min(open[k], close[k]) - low[k]
        float mid = (high[k] + low[k]) / 2
        float bp = body / r * 100
        float tp = topS / r * 100
        float btp = botS / r * 100
        bool doji = bp <= iDojiBody and tp >= iDojiShadow and btp >= iDojiShadow and math.abs(open[k] - mid) / r * 100 <= iDojiMid and math.abs(close[k] - mid) / r * 100 <= iDojiMid
        bool pinBull = not doji and bp <= iPinBody and btp >= iPinMain and botS >= iPinMult * body and tp <= iPinOpp
        bool pinBear = not doji and bp <= iPinBody and tp >= iPinMain and topS >= iPinMult * body and btp <= iPinOpp
        bool maru = not doji and not pinBull and not pinBear and bp >= iMaruBody and (tp + btp) <= iMaruShadow
        t := doji ? 1 : pinBull ? 2 : pinBear ? 3 : maru ? 4 : 5
    t

int ctype = f_type(0)
int ccol = f_col(0)
string fontFam = iFont == "Monospace" ? font.family_monospace : font.family_default
float bootHi = ta.highest(high, iBootN)[3]
float bootLo = ta.lowest(low, iBootN)[3]

// strong (preferred) marubozu : body >= iMaruPref
f_maruStrong(int k) =>
    float r = high[k] - low[k]
    float body = math.abs(close[k] - open[k])
    r > 0 and body / r * 100 >= iMaruPref and (r - body) / r * 100 <= 100 - iMaruPref
float hh3 = ta.highest(high, 3)
float ll3 = ta.lowest(low, 3)

f_isBig(array<float> same, array<float> allArr, float len) =>
    array<float> ref = same.size() >= iBigMin ? same : allArr
    int cnt = 0
    int n = ref.size()
    if n > 0
        for j = 0 to n - 1
            if len > ref.get(j)
                cnt += 1
    cnt >= iBigMin

f_bigDirMaru(int k, int dir) =>
    bigMaru[k] and f_col(k) == dir

f_pinDir(int k, int dir) =>
    dir == 1 ? f_type(k) == 2 : f_type(k) == 3

f_pinDoji(int k, int dir) =>
    f_type(k) == 1 or f_pinDir(k, dir)

f_beyond(int dir, float price, float lv) =>
    dir == 1 ? price > lv : price < lv

// shapes of the 2-candle conditions 2 and 3 (C1 = offset a, C2 = offset b)
f_c23(int dir, int a, int b) =>
    float m = (high[a] + low[a]) / 2
    bool big1 = bigMaru[a] and f_col(a) == dir
    bool half = dir == 1 ? low[b] > m : high[b] < m
    bool c2 = f_col(b) == dir
    bool c3 = f_col(b) == -dir and f_rng(b) <= iR30 / 100 * f_rng(a)
    big1 and half and (c2 or c3)

// =====================================================================
//  THE SIX PATTERNS  (dir = +1 bullish, -1 bearish)
//  lv = na   -> shape only (real pullback without a line)
//  lv given  -> level conditions applied (real breakout / pullback of a line)
//  confirm   -> conditions 2/3 are registered one candle later (C3 check)
//  returns 0 none, 1 cond.1, 2 cond.2/3, 3 pattern A, 4 pattern B, 5 pattern C
// =====================================================================
f_patId(int dir, float lv, bool confirm) =>
    bool hasLine = not na(lv)
    bool useConf = hasLine and confirm

    bool p1 = f_type(1) == 4 and f_type(0) == 4 and f_col(1) == dir and f_col(0) == dir and (dir == 1 ? close > high[1] : close < low[1]) and f_rng(0) >= iR70 / 100 * f_rng(1)
    if p1 and hasLine
        p1 := f_beyond(dir, close[1], lv) and f_beyond(dir, close, lv)

    int a = useConf ? 2 : 1
    int b = useConf ? 1 : 0
    bool p23 = f_c23(dir, a, b)
    if p23 and hasLine
        float beyondLen = dir == 1 ? high[a] - lv : lv - low[a]
        p23 := beyondLen > iLine30 / 100 * f_rng(a)
    if p23 and useConf
        bool strongBack = f_type(0) == 4 and f_col(0) == -dir and f_beyond(-dir, close, lv)
        bool anyBack = not f_beyond(dir, close, lv) or not f_beyond(dir, close[1], lv)
        p23 := not (strongBack or (iStrict and anyBack))

    bool pre = dir == 1 ? close > math.max(high[2], high[1]) : close < math.min(low[2], low[1])
    bool pA = pre and f_bigDirMaru(2, dir) and f_pinDoji(1, dir) and f_bigDirMaru(0, dir)
    bool insideOrNear = (high[1] <= high[2] and low[1] >= low[2]) or (dir == 1 ? close[1] >= high[2] - iNear / 100 * f_rng(2) : close[1] <= low[2] + iNear / 100 * f_rng(2))
    bool pB = pre and f_pinDoji(2, dir) and (f_type(1) == 4 or f_type(1) == 5) and f_col(1) == dir and insideOrNear and f_bigDirMaru(0, dir)
    bool pC = pre and f_type(2) == 5 and f_type(1) == 5 and f_col(2) == dir and f_col(1) == dir and f_rng(2) >= iR40 / 100 * f_rng(0) and f_rng(1) >= iR40 / 100 * f_rng(0) and f_bigDirMaru(0, dir)
    if hasLine
        pA := pA and f_beyond(dir, close[2], lv) and f_beyond(dir, close, lv)
        pB := pB and f_beyond(dir, close, lv)
        pC := pC and f_beyond(dir, close, lv)

    p1 ? 1 : p23 ? 2 : pA ? 3 : pB ? 4 : pC ? 5 : 0

f_pat(int dir, float lv, bool confirm) =>
    f_patId(dir, lv, confirm) != 0

// =====================================================================
//  DRAWING HELPERS
// =====================================================================
// small pill centered on a line
f_pill(int x, float y, string txt, color c) =>
    label l = na
    if iShowLbl
        l := label.new(x, y, txt, style = label.style_label_center, color = color.new(c, 82), textcolor = c, size = size.small, text_font_family = fontFam)
    l

// debug label
f_lbl(int x, float y, string txt, color c, bool up) =>
    label l = na
    if iShowLbl
        l := label.new(x, y, txt, style = up ? label.style_label_up : label.style_label_down, color = c, textcolor = color.white, size = size.tiny)
    l

// range box with the tag inside (no label clutter)
f_rangeBox(int st, float tp, float bt, color c, string txt) =>
    color bd = iShowRng ? color.new(c, 25) : color(na)
    color bg = iShowRng ? color.new(c, 90) : color(na)
    color tx = iShowRng ? color.new(c, 5) : color(na)
    box.new(st, tp, bar_index, bt, border_color = bd, bgcolor = bg, border_width = 1, border_style = line.style_dashed, text = txt, text_size = size.tiny, text_color = tx, text_halign = text.align_left, text_valign = text.align_top, text_font_family = fontFam)

// kind 1 = breakout (green / red by dir), 2 = pullback, 3 = FBO / neutral
f_closeBox(box b, int kind, int dir, string txt) =>
    color c = kind == 1 ? (dir == 1 ? cUp : cDn) : kind == 2 ? cPB : cFBO
    if iShowRng and not na(b)
        box.set_right(b, bar_index)
        box.set_bgcolor(b, color.new(c, 84))
        box.set_border_color(b, color.new(c, 15))
        box.set_border_style(b, line.style_solid)
        box.set_text(b, txt)
        box.set_text_color(b, color.new(c, 0))

// add a structural point to the zig-zag and connect it to the previous one
f_zzAdd(int x, float y) =>
    int n = zzX.size()
    bool ok = true
    if n > 0
        ok := x > zzX.get(n - 1)
        if ok
            line.new(zzX.get(n - 1), zzY.get(n - 1), x, y, color = cZZ, width = iZZW)
    if ok
        zzX.push(x)
        zzY.push(y)
        if zzX.size() > 400
            zzX.shift()
            zzY.shift()

// =====================================================================
//  ENGINE  (everything runs on confirmed bars only)
// =====================================================================
if barstate.isconfirmed
    // ---------------------------------------------------------------
    // [1] Big marubozu / Big pinbar
    // ---------------------------------------------------------------
    float curLen = f_rng(0)
    if ctype == 4
        array<float> same = mBull
        if ccol != 1
            same := mBear
        bigMaru := f_isBig(same, mAll, curLen) and (not iBigStrong or f_maruStrong(0))
        same.push(curLen)
        if same.size() > iBigN
            same.shift()
        mAll.push(curLen)
        if mAll.size() > iBigN
            mAll.shift()
    if ctype == 2 or ctype == 3
        array<float> sameP = pBull
        if ctype == 3
            sameP := pBear
        bigPin := f_isBig(sameP, pAll, curLen)
        sameP.push(curLen)
        if sameP.size() > iBigN
            sameP.shift()
        pAll.push(curLen)
        if pAll.size() > iBigN
            pAll.shift()

    // ---------------------------------------------------------------
    // [2] shape-only pullback patterns (no line) and the pending CTS level
    // ---------------------------------------------------------------
    bool bullPL = f_pat(1, noLine, false)
    bool bearPL = f_pat(-1, noLine, false)
    mkBull := f_patId(1, noLine, false)
    mkBear := f_patId(-1, noLine, false)

    int fbTrendPre = trend
    float fbLevelPre = na
    if trend != 0
        int pi0 = trend == 1 ? 0 : 1
        if phase.get(pi0) == 1
            fbLevelPre := ext.get(pi0)

    // ---------------------------------------------------------------
    // [3] Market structure  (impulse -> lock -> CTS / BOS / trend change)
    // ---------------------------------------------------------------
    for i = 0 to 1
        int s = i == 0 ? 1 : -1
        int j = 1 - i
        if trend == 0 or trend == s
            float hiS = s == 1 ? high : low
            float loS = s == 1 ? low : high
            if na(ext.get(i))
                ext.set(i, hiS)
                extBar.set(i, bar_index)
                corr.set(i, na)
                corrBar.set(i, bar_index)
                phase.set(i, 0)
                fake.set(i, na)
            else
                // ---- trend change : real breakout of the last BOS in the opposite direction
                bool tc = false
                if trend == s and not na(bos.get(i))
                    tc := f_pat(-s, bos.get(i), true)
                if tc
                    float oldExt = ext.get(i)
                    int oldExtBar = extBar.get(i)
                    float bosLvl = bos.get(i)
                    int bosB = bosBarA.get(i)
                    trend := -s
                    lastDir := -s
                    tcEvt := true
                    float oldCorr = corr.get(i)
                    int oldCorrBar = corrBar.get(i)
                    float curX = s == 1 ? low : high
                    bool useCur = na(oldCorr) or (s == 1 ? curX < oldCorr : curX > oldCorr)
                    ext.set(j, useCur ? curX : oldCorr)
                    extBar.set(j, useCur ? bar_index : oldCorrBar)
                    corr.set(j, na)
                    corrBar.set(j, bar_index)
                    phase.set(j, 0)
                    fake.set(j, na)
                    bos.set(j, oldExt)
                    bosBarA.set(j, oldExtBar)
                    brkOK.set(j, true)
                    brkOK.set(i, false)
                    ext.set(i, na)
                    bos.set(i, na)
                    phase.set(i, 0)
                    fake.set(i, na)
                    if iShowMS
                        color tcCol = s == 1 ? cDn : cUp
                        line.new(bosB, bosLvl, bar_index, bosLvl, color = tcCol, style = line.style_dotted, width = 2)
                        f_pill(int(math.round((bosB + bar_index) / 2.0)), bosLvl, "CHoCH", tcCol)
                    if not na(keyLine)
                        line.set_x2(keyLine, bar_index)
                        keyLine := na
                else if phase.get(i) == 0
                    // ---- stage A : impulse
                    if hiS * s > ext.get(i) * s
                        ext.set(i, hiS)
                        extBar.set(i, bar_index)
                        corr.set(i, na)
                        corrBar.set(i, bar_index)
                    else if na(corr.get(i)) or loS * s < corr.get(i) * s
                        corr.set(i, loS)
                        corrBar.set(i, bar_index)
                    // a real breakout of the recent swing is required before any pullback is recognized
                    bool bootOk = not na(s == 1 ? bootHi : bootLo)
                    if iNeedBrk and not brkOK.get(i) and bootOk and f_pat(s, s == 1 ? bootHi : bootLo, true)
                        brkOK.set(i, true)
                    // real pullback has priority over any range (an active range is closed by it)
                    bool pbNow = s == 1 ? bearPL : bullPL
                    if pbNow and (brkOK.get(i) or not iNeedBrk)
                        phase.set(i, 1)
                        fake.set(i, na)
                        lockEvt := true
                        if boxState == 2
                            f_closeBox(curBox, 2, boxDir, "R" + str.tostring(boxType) + "  pullback")
                            lastDir := -boxDir
                            rngPbEvt := true
                        if boxState == 1 or boxState == 2
                            boxState := 0
                            closedBar := bar_index
                        if na(corr.get(i))
                            corr.set(i, loS)
                            corrBar.set(i, bar_index)
                        if iDbg
                            f_lbl(bar_index, hiS, "lock#" + str.tostring(f_patId(-s, noLine, false)), color.gray, s == -1)
                else
                    // ---- stage B : locked, waiting for a real breakout of the locked extreme
                    bool fboFar = boxState == 3 and boxDir == s and (bar_index - fboStart) > iFarAfter
                    float lineC = fboFar ? (s == 1 ? math.max(ext.get(i), boxTop) : math.min(ext.get(i), boxBot)) : ext.get(i)
                    bool cts = f_pat(s, lineC, true)
                    if cts
                        float lvl = ext.get(i)
                        int tb = extBar.get(i)
                        float bosLvl2 = corr.get(i)
                        int bb = corrBar.get(i)
                        color ctsCol = s == 1 ? cUp : cDn
                        if iShowMS
                            line.new(tb, lvl, bar_index, lvl, color = ctsCol, style = line.style_dotted, width = 2)
                            f_pill(int(math.round((tb + bar_index) / 2.0)), lvl, "CTS", ctsCol)
                        bos.set(i, bosLvl2)
                        bosBarA.set(i, bb)
                        if not na(keyLine)
                            line.set_x2(keyLine, bar_index)
                        if iShowMS
                            keyLine := line.new(bb, bosLvl2, bar_index, bosLvl2, color = color.new(ctsCol, 25), width = 1)
                            f_pill(int(math.round((bb + bar_index) / 2.0)), bosLvl2, "BOS", ctsCol)
                        // Recent High-Low / Key Level boxes (candle bodies of the CTS and BOS candles)
                        if iShowKL
                            int hbK = math.min(4999, math.max(0, bar_index - tb))
                            int lbK = math.min(4999, math.max(0, bar_index - bb))
                            string vC = iShowVol ? "\nVol: " + str.tostring(nz(volume[hbK], 1), format.volume) : ""
                            string vB = iShowVol ? "\nVol: " + str.tostring(nz(volume[lbK], 1), format.volume) : ""
                            if s == 1
                                float topC = high[hbK]
                                float botC = math.min(open[hbK], close[hbK])
                                if botC >= topC
                                    botC := topC - syminfo.mintick * 10
                                box.new(tb, topC, bar_index + iBoxExt, botC, bgcolor = color.new(cUp, 88), border_color = color.new(cUp, 35), border_style = line.style_dotted, border_width = 1, text = "Recent High" + vC, text_size = size.tiny, text_color = cUp, text_halign = text.align_right, text_valign = text.align_center, text_font_family = fontFam)
                                float botB = low[lbK]
                                float topB = math.max(open[lbK], close[lbK])
                                if topB <= botB
                                    topB := botB + syminfo.mintick * 10
                                box.new(bb, topB, bar_index + iBoxExt, botB, bgcolor = color.new(cKeyU, 88), border_color = cKeyU, border_style = line.style_solid, border_width = 1, text = "Key Level" + vB, text_size = size.tiny, text_color = cKeyU, text_halign = text.align_right, text_valign = text.align_center, text_font_family = fontFam)
                            else
                                float botC2 = low[hbK]
                                float topC2 = math.max(open[hbK], close[hbK])
                                if topC2 <= botC2
                                    topC2 := botC2 + syminfo.mintick * 10
                                box.new(tb, topC2, bar_index + iBoxExt, botC2, bgcolor = color.new(cDn, 88), border_color = color.new(cDn, 35), border_style = line.style_dotted, border_width = 1, text = "Recent Low" + vC, text_size = size.tiny, text_color = cDn, text_halign = text.align_right, text_valign = text.align_center, text_font_family = fontFam)
                                float topB2 = high[lbK]
                                float botB2 = math.min(open[lbK], close[lbK])
                                if botB2 >= topB2
                                    botB2 := topB2 - syminfo.mintick * 10
                                box.new(bb, topB2, bar_index + iBoxExt, botB2, bgcolor = color.new(cKeyD, 88), border_color = cKeyD, border_style = line.style_solid, border_width = 1, text = "Key Level" + vB, text_size = size.tiny, text_color = cKeyD, text_halign = text.align_right, text_valign = text.align_center, text_font_family = fontFam)
                        ctsEvt := true
                        brkOK.set(i, true)
                        if s == 1
                            ctsUpEvt := true
                        else
                            ctsDnEvt := true
                        lastDir := s
                        if trend == 0
                            ext.set(j, na)
                            bos.set(j, na)
                            phase.set(j, 0)
                            fake.set(j, na)
                        trend := s
                        // Hide Ranges inside the Correction Zone (FBO boxes are never removed)
                        if iHide
                            int n = rBoxes.size()
                            if n > 0
                                for k = n - 1 to 0
                                    if rStart.get(k) >= tb
                                        box.delete(rBoxes.get(k))
                                        rBoxes.remove(k)
                                        rStart.remove(k)
                            if (boxState == 1 or boxState == 2) and boxStart >= tb
                                boxState := 0
                                closedBar := bar_index
                        // new wave starts on this candle
                        ext.set(i, hiS)
                        extBar.set(i, bar_index)
                        corr.set(i, na)
                        corrBar.set(i, bar_index)
                        phase.set(i, 0)
                        fake.set(i, na)
                    else
                        // new correction: fake beyond the locked extreme, then a break of the previous pullback
                        if not na(fake.get(i)) and not na(corr.get(i)) and loS * s < corr.get(i) * s
                            ext.set(i, fake.get(i))
                            extBar.set(i, fakeBar.get(i))
                            corr.set(i, loS)
                            corrBar.set(i, bar_index)
                            fake.set(i, na)
                        else
                            if na(corr.get(i)) or loS * s < corr.get(i) * s
                                corr.set(i, loS)
                                corrBar.set(i, bar_index)
                            if hiS * s > ext.get(i) * s
                                float fk = fake.get(i)
                                if na(fk) or (s == 1 ? hiS > fk : hiS < fk)
                                    fakeBar.set(i, bar_index)
                                fake.set(i, na(fk) ? hiS : (s == 1 ? math.max(fk, hiS) : math.min(fk, hiS)))

    // real breakout has priority: an active range (not an FBO box) is closed by it
    if (ctsEvt or tcEvt) and (boxState == 1 or boxState == 2)
        if boxState == 2
            f_closeBox(curBox, 1, lastDir, "R" + str.tostring(boxType) + "  " + (ctsEvt ? "CTS" : "CHoCH"))
        boxState := 0
        closedBar := bar_index

    // BOS line keeps extending to the right until a CTS / trend change replaces or ends it
    if not na(keyLine) and not ctsEvt and not tcEvt
        line.set_x2(keyLine, bar_index)

    // ---------------------------------------------------------------
    // [4] FBO
    //     first crossing of the pending CTS level is only remembered; a real breakout has
    //     absolute priority. The FBO is registered only when the attempt FAILED: Close back
    //     on the other side of the line with no real breakout in between. The box starts at
    //     the first crossing candle and follows the fake candles until CTS / trend change.
    // ---------------------------------------------------------------
    if boxState == 3 and (ctsEvt or tcEvt)
        int age = bar_index - fboStart
        if age <= iFarAfter
            box.delete(curBox)
        else
            box.set_right(curBox, bar_index)
            box.set_border_style(curBox, line.style_solid)
        boxState := 0
        closedBar := bar_index

    if fboPend and (ctsEvt or tcEvt or na(fbLevelPre) or fbLevelPre != fboPLine)
        fboPend := false

    if fbTrendPre != 0 and not na(fbLevelPre) and not fboPend and not ctsEvt and not tcEvt and (na(fboLastLine) or fbLevelPre != fboLastLine)
        float fhi = fbTrendPre == 1 ? high : low
        if fhi * fbTrendPre > fbLevelPre * fbTrendPre
            fboPend := true
            fboPLine := fbLevelPre
            fboPBar := bar_index
            fboPExt := fhi
            fboPConf := false
            fboPDir := fbTrendPre

    if fboPend
        if iDbg
            f_lbl(bar_index, fboPDir == 1 ? low : high, "S" + str.tostring(f_patId(fboPDir, noLine, false)) + " L" + str.tostring(f_patId(fboPDir, fboPLine, true)), color.purple, fboPDir == 1)
        fboPExt := fboPDir == 1 ? math.max(fboPExt, high) : math.min(fboPExt, low)
        if fboPDir == 1 ? close < fboPLine : close > fboPLine
            fboPConf := true
        if fboPConf
            fboPend := false
            fboLastLine := fboPLine
            fboEvt := true
            // a type 1-3 range still active is closed here (a pending anchor is dropped silently)
            if boxState == 2
                f_closeBox(curBox, 3, 0, "R" + str.tostring(boxType) + " x FBO")
            if boxState == 1 or boxState == 2
                boxState := 0
                closedBar := bar_index
            // the FBO box is created only when no box is active; it starts at the first crossing candle
            if boxState == 0
                fboStart := fboPBar
                boxState := 3
                boxType := 4
                boxDir := fboPDir
                exitHi := na
                exitLo := na
                if fboPDir == 1
                    boxTop := fboPExt
                    boxBot := fboPLine
                else
                    boxTop := fboPLine
                    boxBot := fboPExt
                curBox := f_rangeBox(fboPBar, boxTop, boxBot, cFBO, "FBO")
                if iShowRng
                    box.set_text_halign(curBox, text.align_center)
                    box.set_text_valign(curBox, text.align_center)
                startedFbo := true

    // ---------------------------------------------------------------
    // [5] Active box : end / extension / confirmation
    // ---------------------------------------------------------------
    if boxState != 0 and not startedFbo
        if boxState == 3
            if boxDir == 1
                if close > boxTop
                    exitHi := na(exitHi) ? high : math.max(exitHi, high)
                else if not na(exitHi)
                    boxTop := math.max(boxTop, exitHi, high)
                    exitHi := na
            else
                if close < boxBot
                    exitLo := na(exitLo) ? low : math.min(exitLo, low)
                else if not na(exitLo)
                    boxBot := math.min(boxBot, exitLo, low)
                    exitLo := na
        else
            float lineD = boxDir == 1 ? boxTop : boxBot
            float lineP = boxDir == 1 ? boxBot : boxTop
            int ek = 0
            if boxState == 2
                if f_pat(boxDir, lineD, true)
                    ek := 1
                else if f_pat(-boxDir, lineP, true)
                    ek := 2
            else
                pendCnt += 1
                bool againstD = boxDir == 1 ? bearPL : bullPL
                if againstD or f_pat(boxDir, lineD, true)
                    ek := 3
            if ek != 0
                if boxState == 2
                    f_closeBox(curBox, ek, boxDir, "R" + str.tostring(boxType) + (ek == 1 ? (boxDir == 1 ? " breakout up" : " breakout down") : " pullback"))
                    lastDir := ek == 1 ? boxDir : -boxDir
                    if ek == 1
                        if boxDir == 1
                            rngUpEvt := true
                        else
                            rngDnEvt := true
                    if ek == 2
                        rngPbEvt := true
                        int ti = boxDir == 1 ? 0 : 1
                        if phase.get(ti) == 0 and not na(ext.get(ti)) and (brkOK.get(ti) or not iNeedBrk)
                            phase.set(ti, 1)
                            fake.set(ti, na)
                            lockEvt := true
                // (anchor killed before confirmation: removed silently)
                boxState := 0
                closedBar := bar_index
            else
                if close > boxTop
                    exitHi := na(exitHi) ? high : math.max(exitHi, high)
                else if not na(exitHi)
                    boxTop := math.max(boxTop, exitHi, high)
                    exitHi := na
                if close < boxBot
                    exitLo := na(exitLo) ? low : math.min(exitLo, low)
                else if not na(exitLo)
                    boxBot := math.min(boxBot, exitLo, low)
                    exitLo := na
                if boxState == 1 and pendCnt >= iConfirm
                    boxState := 2
                    rngNewEvt := true
                    curBox := f_rangeBox(boxStart, boxTop, boxBot, cRng, "R" + str.tostring(boxType))
                    rBoxes.push(curBox)
                    rStart.push(boxStart)

    // ---------------------------------------------------------------
    // [6] Start of a new range (only when no box is active)
    //     priority: FBO (above) -> type 3 -> type 1/2
    // ---------------------------------------------------------------
    int dS = lastDir != 0 ? lastDir : trend
    if boxState == 0 and not startedFbo and dS != 0 and bar_index >= 2
        int idD = dS == 1 ? 0 : 1
        // ---- type 3 : invalid pullback
        bool c1 = f_col(1) == -dS
        float ceilRef = phase.get(idD) == 1 ? (dS == 1 ? high[1] : low[1]) : ext.get(idD)
        bool c2 = not na(ceilRef) and close * dS <= ceilRef * dS
        bool c3 = not (dS == 1 ? (bearPL or bearPLp) : (bullPL or bullPLp))
        bool c4 = bar_index - 1 > closedBar
        if c1 and c2 and c3 and c4
            boxState := 2
            boxType := 3
            boxDir := dS
            boxStart := bar_index - 1
            boxTop := math.max(high, high[1])
            boxBot := math.min(low, low[1])
            exitHi := na
            exitLo := na
            rngNewEvt := true
            curBox := f_rangeBox(boxStart, boxTop, boxBot, cRng, "R3")
            rBoxes.push(curBox)
            rStart.push(boxStart)
        else
            // ---- type 1 / 2 : Big marubozu or Big pinbar against the trend direction
            bool anchorMaru = bigMaru and ccol == -dS
            bool anchorPin = bigPin and ctype == (dS == 1 ? 3 : 2)
            if bar_index > closedBar and (anchorMaru or anchorPin)
                boxState := 1
                boxType := anchorMaru ? 1 : 2
                boxDir := dS
                boxStart := bar_index
                boxTop := high
                boxBot := low
                exitHi := na
                exitLo := na
                pendCnt := 0

    // ---------------------------------------------------------------
    // [7] Update drawing + remember flags
    // ---------------------------------------------------------------
    if boxState >= 2 and not na(curBox)
        box.set_right(curBox, bar_index)
        box.set_top(curBox, boxTop)
        box.set_bottom(curBox, boxBot)
    bearPLp := bearPL
    bullPLp := bullPL

    // ---------------------------------------------------------------
    // [8] FBO box : the far side follows the fake candles (wicks included)
    // ---------------------------------------------------------------
    if boxState == 3 and not startedFbo and not na(curBox)
        if boxDir == 1 and close <= boxTop
            boxTop := math.max(boxTop, high)
        if boxDir == -1 and close >= boxBot
            boxBot := math.min(boxBot, low)
        box.set_top(curBox, boxTop)
        box.set_bottom(curBox, boxBot)
        box.set_right(curBox, bar_index)

    // ---------------------------------------------------------------
    // [9] Wave zig-zag : tops (CTS levels) and correction extremes (BOS), higher lows in an
    //     uptrend / lower highs in a downtrend, plus the live (unfinished) leg
    // ---------------------------------------------------------------
    if iShowZZ
        if ctsEvt
            int zi = ctsUpEvt ? 0 : 1
            float zTop = sExt.get(zi)
            float zLow = sCorr.get(zi)
            int zbt = sExtBar.get(zi)
            int zbl = sCorrBar.get(zi)
            if not na(zTop) and not na(zLow) and zbt < zbl
                f_zzAdd(zbt, zTop)
                f_zzAdd(zbl, zLow)
        if tcEvt
            int oi = trend == 1 ? 1 : 0
            float oTop = sExt.get(oi)
            if not na(oTop)
                f_zzAdd(sExtBar.get(oi), oTop)
        line.delete(zzL1)
        int zn = zzX.size()
        if trend != 0 and zn > 0
            int li = trend == 1 ? 0 : 1
            float le = ext.get(li)
            int eb = extBar.get(li)
            int lx = zzX.get(zn - 1)
            if not na(le) and eb > lx
                zzL1 := line.new(lx, zzY.get(zn - 1), eb, le, color = color.new(cZZ, 35), style = line.style_dashed, width = iZZW)
    sExt.set(0, ext.get(0))
    sExt.set(1, ext.get(1))
    sCorr.set(0, corr.get(0))
    sCorr.set(1, corr.get(1))
    sExtBar.set(0, extBar.get(0))
    sExtBar.set(1, extBar.get(1))
    sCorrBar.set(0, corrBar.get(0))
    sCorrBar.set(1, corrBar.get(1))

// =====================================================================
//  CANDLE COLORS / MARKERS
// =====================================================================
color typeCol = ctype == 1 ? color.gray : ctype == 2 ? color.blue : ctype == 3 ? color.purple : ctype == 4 ? color.orange : ctype == 5 ? color.silver : na
barcolor(iColorTypes ? typeCol : na)

bgcolor(boxState >= 2 ? color.new(cRng, 96) : na, title = "Range active")

plotshape(ctsUpEvt, title = "CTS up", style = shape.triangleup, location = location.belowbar, color = cUp, size = size.tiny)
plotshape(ctsDnEvt, title = "CTS down", style = shape.triangledown, location = location.abovebar, color = cDn, size = size.tiny)
plotshape(tcEvt, title = "Trend change", style = shape.diamond, location = location.abovebar, color = cPB, size = size.tiny)

plotshape(iMarks and mkBear == 1, title = "bear cond.1", style = shape.circle, location = location.abovebar, color = color.maroon, text = "1", textcolor = color.maroon, size = size.tiny)
plotshape(iMarks and mkBear == 2, title = "bear cond.2/3", style = shape.circle, location = location.abovebar, color = color.maroon, text = "2/3", textcolor = color.maroon, size = size.tiny)
plotshape(iMarks and mkBear == 3, title = "bear A", style = shape.circle, location = location.abovebar, color = color.purple, text = "A", textcolor = color.purple, size = size.tiny)
plotshape(iMarks and mkBear == 4, title = "bear B", style = shape.circle, location = location.abovebar, color = color.purple, text = "B", textcolor = color.purple, size = size.tiny)
plotshape(iMarks and mkBear == 5, title = "bear C", style = shape.circle, location = location.abovebar, color = color.purple, text = "C", textcolor = color.purple, size = size.tiny)
plotshape(iMarks and mkBull == 1, title = "bull cond.1", style = shape.circle, location = location.belowbar, color = color.teal, text = "1", textcolor = color.teal, size = size.tiny)
plotshape(iMarks and mkBull == 2, title = "bull cond.2/3", style = shape.circle, location = location.belowbar, color = color.teal, text = "2/3", textcolor = color.teal, size = size.tiny)
plotshape(iMarks and mkBull == 3, title = "bull A", style = shape.circle, location = location.belowbar, color = color.blue, text = "A", textcolor = color.blue, size = size.tiny)
plotshape(iMarks and mkBull == 4, title = "bull B", style = shape.circle, location = location.belowbar, color = color.blue, text = "B", textcolor = color.blue, size = size.tiny)
plotshape(iMarks and mkBull == 5, title = "bull C", style = shape.circle, location = location.belowbar, color = color.blue, text = "C", textcolor = color.blue, size = size.tiny)
plotshape(iMarks and bigMaru and ccol == -1, title = "Big bearish marubozu", style = shape.triangleup, location = location.belowbar, color = color.red, text = "B", textcolor = color.red, size = size.tiny)
plotshape(iMarks and bigMaru and ccol == 1, title = "Big bullish marubozu", style = shape.triangledown, location = location.abovebar, color = color.green, text = "B", textcolor = color.green, size = size.tiny)
plotshape(iMarks and bigPin, title = "Big pinbar", style = shape.diamond, location = location.abovebar, color = color.orange, text = "P", textcolor = color.orange, size = size.tiny)

// =====================================================================
//  IMBALANCE / FVG
// =====================================================================
bool isBullC = close > open
bool isBearC = close < open
bool isMaruC = ctype == 4
float avgRange = ta.sma(high - low, 20)

bool bm0 = f_col(0) == 1 and f_type(0) == 4
bool bm1 = f_col(1) == 1 and f_type(1) == 4
bool bm2 = f_col(2) == 1 and f_type(2) == 4
bool sm0 = f_col(0) == -1 and f_type(0) == 4
bool sm1 = f_col(1) == -1 and f_type(1) == 4
bool sm2 = f_col(2) == -1 and f_type(2) == 4

float bullGap = low - nz(high[2], high)
int bullMaruCnt = (bm2 ? 1 : 0) + (bm1 ? 1 : 0) + (bm0 ? 1 : 0)
bool bullSmallGap = bullGap > 0 and bullGap < avgRange * 0.25
int bullImbType = 0
if bullGap > 0 and bullMaruCnt > 0
    if bullSmallGap
        bullImbType := 1
    else if f_col(2) == -1
        bullImbType := 2
    else if f_col(2) == 1 and f_col(1) == 1 and isBullC and bullMaruCnt >= 2
        bullImbType := 3
    else
        bullImbType := 2

float bearGap = nz(low[2], low) - high
int bearMaruCnt = (sm2 ? 1 : 0) + (sm1 ? 1 : 0) + (sm0 ? 1 : 0)
bool bearSmallGap = bearGap > 0 and bearGap < avgRange * 0.25
int bearImbType = 0
if bearGap > 0 and bearMaruCnt > 0
    if bearSmallGap
        bearImbType := 1
    else if f_col(2) == 1
        bearImbType := 2
    else if f_col(2) == -1 and f_col(1) == -1 and isBearC and bearMaruCnt >= 2
        bearImbType := 3
    else
        bearImbType := 2

var line bullImbTop = na
var line bullImbBot = na
var line bearImbTop = na
var line bearImbBot = na

bool fvgLock = iBlockFVG and boxState >= 2

if iShowImb and not fvgLock
    if bullImbType > 0
        color colI = bullImbType == 3 ? colBullStrongest : bullImbType == 2 ? colBullStrong : colBullWeak
        bool consecutive = not na(bullImbTop) and (line.get_x2(bullImbTop) == bar_index - 1)
        if not consecutive
            bullImbBot := line.new(bar_index[2], high[2], bar_index, high[2], color = colI, style = line.style_dotted, width = 2)
            bullImbTop := line.new(bar_index[2], low, bar_index, low, color = colI, style = line.style_dotted, width = 2)
        else
            line.set_y1(bullImbTop, low)
            line.set_y2(bullImbTop, low)
            line.set_x2(bullImbTop, bar_index)
            line.set_x2(bullImbBot, bar_index)
            line.set_color(bullImbTop, colI)
            line.set_color(bullImbBot, colI)
    if bearImbType > 0
        color colI2 = bearImbType == 3 ? colBearStrongest : bearImbType == 2 ? colBearStrong : colBearWeak
        bool consecutive2 = not na(bearImbTop) and (line.get_x2(bearImbTop) == bar_index - 1)
        if not consecutive2
            bearImbTop := line.new(bar_index[2], low[2], bar_index, low[2], color = colI2, style = line.style_dotted, width = 2)
            bearImbBot := line.new(bar_index[2], high, bar_index, high, color = colI2, style = line.style_dotted, width = 2)
        else
            line.set_y1(bearImbBot, high)
            line.set_y2(bearImbBot, high)
            line.set_x2(bearImbBot, bar_index)
            line.set_x2(bearImbTop, bar_index)
            line.set_color(bearImbTop, colI2)
            line.set_color(bearImbBot, colI2)

// =====================================================================
//  FIB ZONES (0.618 / 0.8 retracement of the current structural leg)
// =====================================================================
var line fibB618 = na
var line fibB800 = na
var line fibS618 = na
var line fibS800 = na

if barstate.islast and iShowFib
    float fibHigh = trend == 1 ? ext.get(0) : trend == -1 ? bos.get(1) : na
    float fibLow  = trend == -1 ? ext.get(1) : trend == 1 ? bos.get(0) : na
    int fibHighBar = trend == 1 ? extBar.get(0) : trend == -1 ? bosBarA.get(1) : bar_index
    int fibLowBar  = trend == -1 ? extBar.get(1) : trend == 1 ? bosBarA.get(0) : bar_index
    float fibRange = fibHigh - fibLow
    if not na(fibRange) and fibRange > 0
        if trend == 1
            float y618 = fibHigh - fibRange * 0.618
            float y800 = fibHigh - fibRange * 0.800
            if na(fibB618)
                fibB618 := line.new(fibLowBar, y618, bar_index, y618, color = cFib, style = line.style_dotted)
                fibB800 := line.new(fibLowBar, y800, bar_index, y800, color = cFib, style = line.style_dotted)
            else
                line.set_xy1(fibB618, fibLowBar, y618)
                line.set_xy2(fibB618, bar_index, y618)
                line.set_xy1(fibB800, fibLowBar, y800)
                line.set_xy2(fibB800, bar_index, y800)
            line.delete(fibS618)
            line.delete(fibS800)
            fibS618 := na
            fibS800 := na
        else if trend == -1
            float y618s = fibLow + fibRange * 0.618
            float y800s = fibLow + fibRange * 0.800
            if na(fibS618)
                fibS618 := line.new(fibHighBar, y618s, bar_index, y618s, color = cFib, style = line.style_dotted)
                fibS800 := line.new(fibHighBar, y800s, bar_index, y800s, color = cFib, style = line.style_dotted)
            else
                line.set_xy1(fibS618, fibHighBar, y618s)
                line.set_xy2(fibS618, bar_index, y618s)
                line.set_xy1(fibS800, fibHighBar, y800s)
                line.set_xy2(fibS800, bar_index, y800s)
            line.delete(fibB618)
            line.delete(fibB800)
            fibB618 := na
            fibB800 := na

// =====================================================================
//  DASHBOARD
// =====================================================================
dashPos = iDashPos == "Top Left" ? position.top_left : iDashPos == "Top Right" ? position.top_right : iDashPos == "Bottom Left" ? position.bottom_left : position.bottom_right
var table dash = table.new(dashPos, 2, 7, bgcolor = color.new(#131722, 6), frame_color = color.new(#787B86, 40), frame_width = 1, border_color = color.new(#787B86, 75), border_width = 1)

if barstate.islast and iDash
    int di = trend == 1 ? 0 : 1
    bool hasT = trend != 0
    string tTxt = trend == 1 ? "▲ Bullish" : trend == -1 ? "▼ Bearish" : "– undetermined"
    color tCol = trend == 1 ? cUp : trend == -1 ? cDn : color.gray
    string phTxt = not hasT ? "–" : phase.get(di) == 1 ? "Pullback locked" : "Impulse"
    float pendC = hasT and phase.get(di) == 1 ? ext.get(di) : na
    float bosL = hasT ? bos.get(di) : na
    string rTxt = boxState == 2 ? "R" + str.tostring(boxType) + (boxDir == 1 ? " ▲" : " ▼") : boxState == 1 ? "anchor pending" : boxState == 3 ? "FBO box" : "–"
    string fTxt = fboPend ? "attempt..." : boxState == 3 ? "registered" : "–"
    table.cell(dash, 0, 0, "SMC Rohi", text_color = color.white, text_size = size.small, text_halign = text.align_left, bgcolor = color.new(#2962FF, 20), text_font_family = fontFam)
    table.cell(dash, 1, 0, "Pro", text_color = color.white, text_size = size.small, text_halign = text.align_right, bgcolor = color.new(#2962FF, 20), text_font_family = fontFam)
    table.cell(dash, 0, 1, "Trend", text_color = color.new(color.white, 35), text_size = size.small, text_halign = text.align_left, text_font_family = fontFam)
    table.cell(dash, 1, 1, tTxt, text_color = tCol, text_size = size.small, text_halign = text.align_right, text_font_family = fontFam)
    table.cell(dash, 0, 2, "Phase", text_color = color.new(color.white, 35), text_size = size.small, text_halign = text.align_left, text_font_family = fontFam)
    table.cell(dash, 1, 2, phTxt, text_color = color.white, text_size = size.small, text_halign = text.align_right, text_font_family = fontFam)
    table.cell(dash, 0, 3, "Pending CTS", text_color = color.new(color.white, 35), text_size = size.small, text_halign = text.align_left, text_font_family = fontFam)
    table.cell(dash, 1, 3, na(pendC) ? "–" : str.tostring(pendC, format.mintick), text_color = color.white, text_size = size.small, text_halign = text.align_right, text_font_family = fontFam)
    table.cell(dash, 0, 4, "BOS", text_color = color.new(color.white, 35), text_size = size.small, text_halign = text.align_left, text_font_family = fontFam)
    table.cell(dash, 1, 4, na(bosL) ? "–" : str.tostring(bosL, format.mintick), text_color = color.white, text_size = size.small, text_halign = text.align_right, text_font_family = fontFam)
    table.cell(dash, 0, 5, "Range", text_color = color.new(color.white, 35), text_size = size.small, text_halign = text.align_left, text_font_family = fontFam)
    table.cell(dash, 1, 5, rTxt, text_color = boxState == 2 ? cRng : color.white, text_size = size.small, text_halign = text.align_right, text_font_family = fontFam)
    table.cell(dash, 0, 6, "FBO", text_color = color.new(color.white, 35), text_size = size.small, text_halign = text.align_left, text_font_family = fontFam)
    table.cell(dash, 1, 6, fTxt, text_color = fboPend ? cPB : color.white, text_size = size.small, text_halign = text.align_right, text_font_family = fontFam)

// =====================================================================
//  ALERTS
// =====================================================================
alertcondition(ctsUpEvt,  title = "CTS up (bullish continuation)",   message = "SMC Rohi Pro: CTS up - real breakout of the locked high")
alertcondition(ctsDnEvt,  title = "CTS down (bearish continuation)", message = "SMC Rohi Pro: CTS down - real breakout of the locked low")
alertcondition(tcEvt,     title = "Trend change (CHoCH)",            message = "SMC Rohi Pro: trend change - BOS broken by a real breakout")
alertcondition(lockEvt,   title = "Real pullback locked",            message = "SMC Rohi Pro: real pullback locked the wave extreme")
alertcondition(rngNewEvt, title = "New range",                       message = "SMC Rohi Pro: new price action range")
alertcondition(rngUpEvt,  title = "Range broken up",                 message = "SMC Rohi Pro: range closed by a real breakout up")
alertcondition(rngDnEvt,  title = "Range broken down",               message = "SMC Rohi Pro: range closed by a real breakout down")
alertcondition(rngPbEvt,  title = "Range closed by pullback",        message = "SMC Rohi Pro: range closed by a real pullback")
alertcondition(fboEvt,    title = "FBO registered",                  message = "SMC Rohi Pro: fake breakout registered")
